<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal LineageOS 24.0 manifest for building kernels, kernel modules, DTBs
  and DTBOs with the native AOSP/LineageOS build system.

  The tree supports both kernel layouts used by LineageOS 24.0:

    * legacy in-tree kernels under kernel/<vendor>/<device>, built with the
      kernel's own Makefiles;
    * kernel platform trees under kernel/platform/kernel-<version>, built with
      Kleaf/Bazel and wired into the Android build through
      TARGET_KERNEL_PLATFORM_TARGET.

  This file contains the AOSP base projects.  LineageOS-specific projects are
  included from snippets/ so the manifest stays close to the upstream
  LineageOS layout:

    snippets/lineage.xml   LineageOS forks and Lineage-only projects
    snippets/minimal.xml   this manifest, checked out at kernel-build/
    snippets/kernel-*.xml  optional kernel platform workspaces
-->
<manifest>

  <remote  name="github"
           fetch="https://github.com"
           review="https://review.lineageos.org" />

  <remote  name="aosp"
           fetch="https://android.googlesource.com"
           review="https://android-review.googlesource.com"
           revision="refs/tags/android-17.0.0_r1" />

  <default revision="refs/heads/lineage-24.0"
           remote="github"
           sync-j="4" />

  <include name="snippets/lineage.xml" />
  <include name="snippets/minimal.xml" />

  <project path="build/blueprint" name="platform/build/blueprint" remote="aosp" clone-depth="1" />
  <project path="build/pesto" name="platform/build/pesto" remote="aosp" clone-depth="1" />
  <project path="build/release" name="platform/build/release" remote="aosp" clone-depth="1" />
