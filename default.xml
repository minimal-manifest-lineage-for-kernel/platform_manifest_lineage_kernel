<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal LineageOS 22.2 manifest for building kernels, DTBs, DTBOs and
  kernel-module images with the native AOSP/LineageOS build system.

  This file contains the AOSP base projects.  LineageOS-specific projects and
  the kernel-only forks are included from snippets/ so the manifest stays close
  to the upstream LineageOS layout:

    snippets/lineage.xml   LineageOS forks and Lineage-only projects
    snippets/minimal.xml   this project's kernel-only forks
-->
<manifest>

  <remote  name="github"
           fetch="https://github.com"
           review="https://review.lineageos.org" />

  <remote  name="aosp"
           fetch="https://android.googlesource.com"
           review="https://android-review.googlesource.com"
           revision="refs/tags/android-15.0.0_r32" />

  <default revision="refs/heads/lineage-22.2"
           remote="github"
           sync-j="4" />

  <include name="snippets/lineage.xml" />
  <include name="snippets/minimal.xml" />

  <project path="build/bazel" name="platform/build/bazel" remote="aosp" clone-depth="1">
    <linkfile src="bazel.WORKSPACE" dest="WORKSPACE" />
    <linkfile src="bazel.sh" dest="tools/bazel" />
    <linkfile src="bazel.BUILD" dest="BUILD" />
  </project>
  <project path="build/bazel_common_rules" name="platform/build/bazel_common_rules" remote="aosp" clone-depth="1" />
  <project path="build/pesto" name="platform/build/pesto" remote="aosp" clone-depth="1" />
  <project path="external/compiler-rt" name="platform/external/compiler-rt" remote="aosp" clone-depth="1" />
  <project path="external/f2fs-tools" name="platform/external/f2fs-tools" remote="aosp" clone-depth="1" />
  <project path="external/fmtlib" name="platform/external/fmtlib" remote="aosp" clone-depth="1" />
  <project path="external/fsverity-utils" name="platform/external/fsverity-utils" remote="aosp" clone-depth="1" />
  <project path="external/go-cmp" name="platform/external/go-cmp" remote="aosp" clone-depth="1" />
  <project path="external/golang-protobuf" name="platform/external/golang-protobuf" remote="aosp" clone-depth="1" />
  <project path="external/icu" name="platform/external/icu" remote="aosp" clone-depth="1" />
  <project path="external/kmod" name="platform/external/kmod" remote="aosp" clone-depth="1" />
  <project path="external/libcxx" name="platform/external/libcxx" remote="aosp" clone-depth="1" />
  <project path="external/libcxxabi" name="platform/external/libcxxabi" remote="aosp" clone-depth="1" />
  <project path="external/lz4" name="platform/external/lz4" remote="aosp" clone-depth="1" />
  <project path="external/protobuf" name="platform/external/protobuf" remote="aosp" clone-depth="1" />
  <project path="external/spdx-tools" name="platform/external/spdx-tools" remote="aosp" clone-depth="1" />
  <project path="external/sqlite" name="platform/external/sqlite" remote="aosp" clone-depth="1" />
  <project path="external/starlark-go" name="platform/external/starlark-go" remote="aosp" clone-depth="1" />
  <project path="external/zlib" name="platform/external/zlib" remote="aosp" clone-depth="1" />
  <project path="libnativehelper" name="platform/libnativehelper" remote="aosp" clone-depth="1" />
  <project path="prebuilts/build-tools" name="platform/prebuilts/build-tools" remote="aosp" clone-depth="1" />
  <project path="prebuilts/clang-tools" name="platform/prebuilts/clang-tools" remote="aosp" clone-depth="1" />
  <project path="prebuilts/clang/host/linux-x86" name="platform/prebuilts/clang/host/linux-x86" remote="aosp" clone-depth="1" />
  <project path="prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" name="platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" remote="aosp" clone-depth="1" />
  <project path="prebuilts/go/linux-x86" name="platform/prebuilts/go/linux-x86" remote="aosp" clone-depth="1" />
